# gates_of_heck configuration. All keys optional; delete what you don't use.
# Full key reference: docs/config.md in the gates_of_heck checkout
# (or .gatesrc.example there for a commented starter with every key).
GOH_MAX_LINES=500                 # file-length cap; unset disables the check
# GOH_EXCLUDE='vendor/|\.generated\.'   # shared vendor/generated exemption
# GOH_ALLOW='<glyph>'                          # extra permitted characters (keep minimal)
# GOH_LINE_EXCLUDE='third_party/'       # length-only alias
# Rust coverage floor. 61% is the measured figure (61.39%, 2201/3585 lines on
# 2026-09-07), set just under it as a RATCHET against losing tests -- not as a
# target anyone picked. Raise it when coverage rises; never lower it to make a
# red run green. The uncovered remainder is concentrated in the paths that need
# real hardware or a live event tap (src/device, src/bin/antiknob-daemon).
GOH_COV_FLOOR_RUST=61
# GOH_PY_COV_MIN=95
# GOH_SWIFT_MODE=xcode            # or spm
# GOH_SWIFT_SCHEME=MyAppTests
# GOH_SWIFT_COV_MIN=95
# GOH_MAX_SCRATCH_GB=25 etc. live OUTSIDE the gates since v0.8.0 — set them
# in the environment for the scripts repo's bin/disk_hygiene.sh, not here.

# Every scanner's floor (goh v0.27.0, docs/config.md): a full-scope scan that
# reads less than this has lost its subject and is red, not clean. Nine tenths
# of what each read on 2026-10-14 (the house rule); lower one with the tree in
# the same commit, never to absorb a scan that went blind.
GOH_EMOJI_MIN_FILES=144               # read 160
GOH_CONFLICT_MARKERS_MIN_FILES=148    # read 165
GOH_FILE_LENGTH_MIN_FILES=116         # read 129
GOH_SECRETS_MIN_FILES=144             # read 160
GOH_SHELL_LINT_MIN_FILES=6            # read 7
GOH_EARLY_EXIT_PIPE_MIN_FILES=10      # read 12
GOH_DEAD_AFTER_EXEC_MIN_FILES=10      # read 12
GOH_BARE_HOOK_INDEX_MIN_FILES=10      # read 12
GOH_BARE_PYTHON_MIN_FILES=5           # read 6
GOH_CHECKOUT_CREDENTIALS_MIN_FILES=1  # read 1
GOH_MD_LINKS_MIN_LINKS=18             # read 20
GOH_UNREAPED_SPAWN_MIN_FILES=45       # read 51
GOH_STATUS_MARKERS_MIN_FILES=116      # read 129

# Every configuration this crate ships (goh GOH_RUST_LINT_CONFIGS, ':'-separated).
# antiknob is Apple silicon macOS only and declares no cargo features, so the
# configurations are the target and the PROFILE: `install.sh` builds --release,
# which turns debug_assertions off, and a lint error behind cfg(debug_assertions)
# is invisible to the default dev-profile clippy step. A dev build of the target
# is the step the gate already runs; naming it with --target keeps the claim
# explicit rather than inferred from the machine.
GOH_RUST_LINT_CONFIGS='--target aarch64-apple-darwin:--release'
