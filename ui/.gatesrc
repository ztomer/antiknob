# Swift-half gate config. Read by gates/swift_gate.sh, which cd's here.
GOH_SWIFT_MODE=spm
GOH_SWIFT_LINT_BASELINE=.swiftlint-baseline.json

# Coverage floor. READ THIS BEFORE TRUSTING THE NUMBER: 6% is the honest
# measured figure, not a quality bar. Most of the package is SwiftUI view
# bodies that no unit test executes; the logic that IS reachable sits far
# higher (Models.swift 64%, SocketWire near total). So this floor is a
# ratchet against DELETING tests. It moves up as logic gains a seam and tests.
#
# The number is over SOURCES only: the house checker stopped counting Tests/
# on 2026-09-07, which is why this reads 3 and not 6 -- the old figure was
# inflated by the test files, which are ~100% covered by definition. A floor
# on that could be met by writing tests that assert nothing. See PLAN.md for
# what would make it mean more.
#
# 2026-09-07: 3 -> 4. Pulling the CLI discovery and status parsing out of
# ConfigStore gave them a seam and 20 tests, and the measured figure moved
# 3.4% -> 4.8%. The floor follows the measurement, decimal shaved.
GOH_SWIFT_COV_MIN=4
